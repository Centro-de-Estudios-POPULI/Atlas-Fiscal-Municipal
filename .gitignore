# Carpetas de trabajo interno (no van al sitio público)
municipios/_herramientas/
municipios/_plantillas/
municipios/_datos/
municipios/_ocr_cache/
gobernaciones/_herramientas/
gobernaciones/_plantillas/
gobernaciones/_datos/
gobernaciones/_ocr_cache/

# Archivos de datos y trabajo
*.xlsx
*.py
*.json
*.csv
*.geojson
*.topojson
*.txt
__pycache__/
*.pyc

# Instrucciones internas
CLAUDE.md

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Assets del Atlas Socioeconómico Municipal (SÍ se publican al sitio)
# ⚠️ La regla de arriba ignora *.json: todo asset nuevo necesita su excepción o
#    el sitio queda pidiendo un archivo que nunca se subió. El código degrada en
#    silencio (cae a ponderar por población) y el error no se ve hasta que
#    alguien compara una cifra nacional.
!catalogo.json
!data.json
!denominadores.json
!data_2012.json
!denominadores_2012.json
# formato por columna: la mitad de peso y 5× menos que parsear. Conviven con los
# viejos mientras se verifica, y el HTML cae a los viejos si estos no están.
!data.col.json
!data_2012.col.json
!denominadores.col.json
!denominadores_2012.col.json
!municipios.topojson
!sudamerica.topojson

# Assets del Atlas Fiscal Municipal (SÍ se publican al sitio)
!fiscal_catalogo.json
!fiscal_data.json
